{
  "manifest_version": 3,
  "name": "ITAPF — r/itookapicture Filter",
  "short_name": "ITAPF",
  "version": "1.0.0",
  "description": "Hide NSFW and portrait posts from r/itookapicture on Reddit.",
  "permissions": ["storage"],
  "action": {
    "default_title": "ITAPF filters",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.reddit.com/*"],
      "css": ["src/content.css"],
      "js": ["src/content.js"],
      "run_at": "document_start"
    }
  ]
}
